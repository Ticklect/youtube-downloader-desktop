import { AboutSlint, LineEdit, ScrollView } from "std-widgets.slint";

export struct VideoRow {
    id: string,
    title: string,
    title-long: bool,
    detail: string,
    secondary: string,
    thumbnail: image,
    selected: bool,
}

export struct TaskRow {
    job-index: int,
    has-output: bool,
    title: string,
    title-long: bool,
    detail: string,
    metadata: string,
    thumbnail: image,
    progress: int,
    state: string,
}

export struct ChannelRow {
    name: string,
    url: string,
}

component KeyboardTarget {
    in property <bool> enabled: true;
    // Model row updates can invalidate the active focus item while the
    // callback runs. Only opt-in controls (video checkboxes) reacquire it.
    in property <bool> retain-focus-after-key: false;
    out property <bool> has-hover <=> hit.has-hover;
    out property <bool> has-focus <=> keyboard.has-focus;
    callback clicked <=> hit.clicked;
    forward-focus: keyboard;
    keyboard := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                hit.clicked();
                if (root.retain-focus-after-key && root.enabled) {
                    keyboard.focus();
                }
                return accept;
            }
            return reject;
        }
    }
    // Render the pointer receiver above the keyboard-only element. A zero-size
    // FocusScope must never occlude the visible hit target, including on a
    // maximized Windows window.
    hit := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: pointer;
    }
}

component ControlButton inherits Rectangle {
    in property <string> label: "";
    in property <string> hint: "";
    in property <bool> left-aligned: false;
    in property <length> min-button-width: 58px;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <bool> primary: false;
    in property <color> accent: #d9002b;
    in property <color> accent-ink: #ffffff;
    in property <color> surface: #202124;
    in property <color> border: #36373b;
    in property <color> text-color: #f5f5f6;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: area;

    height: 39px;
    min-width: root.min-button-width;
    border-radius: 8px;
    border-width: area.has-focus ? 2px : 1px;
    border-color: area.has-focus ? root.text-color : !root.enabled ? root.border : root.primary ? root.accent : root.border;
    background: !root.enabled ? root.surface : root.primary ? (area.has-hover ? root.accent.brighter(0.10) : root.accent)
        : root.selected ? root.surface.brighter(0.48) : area.has-hover ? #303037 : root.surface;
    Text {
        text: root.label;
        x: root.left-aligned ? 10px : 5px;
        width: parent.width - (root.left-aligned ? 20px : 10px);
        y: root.hint == "" ? 0px : 5px;
        height: root.hint == "" ? parent.height : 22px;
        overflow: elide;
        color: !root.enabled ? #83838c : root.primary ? root.accent-ink : root.text-color;
        font-size: 13px;
        font-weight: root.primary ? 700 : 600;
        horizontal-alignment: root.left-aligned ? left : center;
        vertical-alignment: center;
    }
    if root.selected && root.enabled && !root.primary: Rectangle {
        x: parent.width - 12px; y: 6px; width: 5px; height: 5px;
        border-radius: 3px;
        background: root.accent;
    }
    if root.hint != "": Text {
        y: 27px; width: parent.width; height: 20px;
        text: root.hint; color: #bdbdc5; font-size: 11px;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }
    area := KeyboardTarget {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component MediaThumbnail inherits Rectangle {
    in property <image> artwork;
    in property <string> duration: "";
    in property <color> placeholder: #28282d;
    background: root.placeholder;
    border-radius: 7px;
    clip: true;
    Image { width: parent.width; height: parent.height; source: root.artwork; image-fit: cover; }
    if root.artwork.width == 0: Text {
        width: parent.width; height: parent.height;
        text: "▶"; color: #bcbcc5; font-size: 19px;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if root.duration != "" && root.duration != "Duration unknown": Rectangle {
        x: parent.width - self.width - 5px;
        y: parent.height - self.height - 5px;
        width: max(30px, duration-label.preferred-width + 10px);
        height: 21px;
        background: #111115ed;
        border-radius: 4px;
        duration-label := Text {
            width: parent.width; height: parent.height;
            text: root.duration; color: #ffffff; font-size: 11px; font-weight: 700;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }
}

export component MainWindow inherits Window {
    title: "YouTube Downloader Desktop — Beta";
    icon: @image-url("../assets/app-icon.png");
    no-frame: true;
    min-width: 880px;
    min-height: 625px;
    max-width: 10000px;
    max-height: 10000px;
    default-font-family: "Segoe UI";
    background: #101113;

    in-out property <string> theme: "red";
    private property <bool> mono: root.theme == "mono";
    private property <color> accent: root.mono ? #eeeeee : #df153f;
    private property <color> accent-ink: root.mono ? #111214 : #ffffff;
    private property <color> canvas: root.mono ? #141414 : #111115;
    private property <color> surface: root.mono ? #212121 : #1a1a20;
    private property <color> field: root.mono ? #2c2c2c : #25252d;
    private property <color> edge: root.mono ? #383838 : #32323b;
    private property <color> ink: #f5f5f6;
    private property <color> muted: root.mono ? #d0d0d0 : #b0b2b6;
    private property <color> faded: root.mono ? #a4a4a4 : #95989d;
    private property <color> selected-bg: root.mono ? #303030 : #2d1e28;
    private property <color> row-hover: root.mono ? #292929 : #25252e;
    private property <color> selected-hover: root.mono ? #383838 : #37232f;
    private property <color> divider: root.mono ? #2b2b2b : #26262e;
    private property <length> library-row-height: root.compact-view ? 72px : 94px;
    private property <length> library-art-width: root.compact-view ? 104px : 136px;
    private property <length> library-title-expansion: 64px;
    private property <length> queue-row-height: root.compact-view ? 94px : 106px;
    private property <length> direct-preview-width: min(368px, max(160px, (root.height - 515px) * 16 / 9));
    private property <bool> has-queue-history: root.pending-items + root.finished-items > 0;

    in-out property <string> channel-url: "";
    in-out property <string> download-folder: "";
    in-out property <string> mode: "video";
    in-out property <string> quality: "best";
    in-out property <string> page: "discover";
    in-out property <string> status-text: "Ready. Paste a channel URL to begin.";
    in-out property <string> channel-error: "";
    in-out property <string> download-error: "";
    in-out property <string> queue-error: "";
    in-out property <bool> queue-save-failed: false;
    in-out property <bool> direct-video-setup: false;
    out property <int> library-first-row: max(0, Math.floor(-root.library-scroll-y / root.library-row-height));
    out property <int> library-visible-rows: max(1, Math.ceil(root.library-scroll-height / root.library-row-height) + 1);
    private property <length> library-scroll-y: 0px;
    private property <length> library-scroll-height: 0px;
    changed library-first-row => { root.request-thumbnails(); }
    changed library-visible-rows => { root.request-thumbnails(); }
    changed page => {
        if root.page == "discover" {
            root.library-scroll-y = 0px;
            root.leave-direct-video();
        }
        root.request-thumbnails();
    }
    in-out property <string> channel-name: "No channel loaded";
    in-out property <string> selected-count: "0 videos selected";
    in-out property <int> selected-items: 0;
    in-out property <int> visible-selected-items: 0;
    in-out property <string> queue-count: "No downloads yet";
    in-out property <string> video-search: "";
    private property <string> expanded-video-id: "";
    private property <int> expanded-task-index: -1;
    in-out property <string> queue-filter: "all";
    in-out property <int> pending-items: 0;
    in-out property <int> failed-items: 0;
    in-out property <int> finished-items: 0;
    in-out property <bool> loading: false;
    in-out property <bool> more-available: false;
    private property <bool> show-pagination: !root.loading
        && (root.more-available || root.loading-more || root.more-error != "");
    in-out property <bool> loading-more: false;
    in-out property <string> more-error: "";
    in-out property <bool> fullscreen-active: false;
    in-out property <bool> maximized-active: false;
    in-out property <bool> compact-view: false;
    changed width => {
        root.compact-view = root.width < 1100px;
    }
    changed video-search => {
        root.library-scroll-y = 0px;
        // The search must refresh when assistive technology changes the
        // bound value, not only for physical keyboard edit notifications.
        root.search-videos();
    }
    in property <[VideoRow]> videos;
    in property <[VideoRow]> selected-videos;
    in property <[TaskRow]> tasks;
    in property <[ChannelRow]> saved-channels;
    in property <[ChannelRow]> recommended-channels;

    callback change-theme(string);
    callback minimize-window();
    callback close-window();
    callback toggle-fullscreen();
    callback toggle-maximize();
    callback load-channel();
    callback load-more();
    callback request-thumbnails();
    callback leave-direct-video();
    callback retry-queue-save();
    callback toggle-video(string);
    callback search-videos();
    callback select-all();
    callback clear-selection();
    callback choose-folder();
    callback start-download();
    callback cancel-downloads();
    callback retry-failed();
    callback clear-finished();
    callback filter-tasks();
    callback cancel-job(int);
    callback retry-job(int);
    callback open-job-folder(int);
    callback add-recommended-channel(string);
    callback remove-saved-channel(string);
    callback open-saved-channel(string);

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 50px;
            background: root.mono ? #1b1b1b : #17181b;
            // Slint asks Windows to move the window after a real drag. Clicks
            // on the navigation tabs and window controls still reach them.
            WindowMoveArea {
                width: parent.width;
                height: parent.height;
            }
            HorizontalLayout {
                    padding-left: 23px;
                    padding-right: 12px;
                    spacing: 5px;
                    Rectangle {
                        width: 192px;
                        height: 50px;
                        background: transparent;
                        Image {
                            source: @image-url("../assets/app-icon.png");
                            x: 0px;
                            y: (parent.height - self.height) / 2;
                            width: 25px;
                            height: 25px;
                            image-fit: contain;
                        }
                        Text {
                            x: 36px; width: parent.width - 36px; height: parent.height;
                            text: "YouTube Downloader"; color: root.ink;
                            font-size: 14px; font-weight: 700; vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    for tab in [
                        { name: "Library", page: "discover" },
                        { name: "Download options", page: "setup" },
                        { name: "Downloads", page: "queue" }
                    ]: Rectangle {
                        width: tab.page == "setup" ? 138px : 101px;
                        height: 50px;
                        background: transparent;
                        Rectangle {
                            y: 8px; height: 34px; width: parent.width;
                            border-radius: 9px;
                            border-width: tab-hit.has-focus ? 1px : 0px;
                            border-color: root.muted;
                            background: root.page == tab.page ? root.field : tab-hit.has-hover ? root.row-hover : transparent;
                            Text {
                                text: tab.name; color: root.page == tab.page ? root.ink : root.muted;
                                font-size: 13px; font-weight: root.page == tab.page ? 700 : 500;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                        accessible-role: button;
                        accessible-label: tab.name;
                        accessible-action-default => { root.page = tab.page; }
                        tab-hit := KeyboardTarget {
                            width: parent.width; height: parent.height;
                            clicked => { root.page = tab.page; }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; height: 50px; background: transparent; }
                    Rectangle { width: 1px; height: 28px; background: root.edge; }
                    ControlButton {
                        width: 37px; min-button-width: 37px; height: 33px;
                        label: "−";
                        accessible-label: "Minimize window";
                        surface: transparent; border: transparent;
                        accent: root.accent; accent-ink: root.accent-ink; text-color: root.ink;
                        clicked => { root.minimize-window(); }
                    }
                    ControlButton {
                        width: 37px; min-button-width: 37px; height: 33px;
                        label: root.maximized-active ? "❐" : "□";
                        accessible-label: root.maximized-active ? "Restore window" : "Maximize window";
                        surface: transparent; border: transparent;
                        accent: root.accent; accent-ink: root.accent-ink; text-color: root.ink;
                        clicked => { root.toggle-maximize(); }
                    }
                    ControlButton {
                        width: 37px; min-button-width: 37px; height: 33px;
                        label: "×";
                        accessible-label: "Close window";
                        surface: transparent; border: transparent;
                        accent: root.accent; accent-ink: root.accent-ink; text-color: root.ink;
                        clicked => { root.close-window(); }
                    }
            }
        }
        Rectangle { height: 1px; background: root.edge; }
        Rectangle {
            background: root.canvas;
            vertical-stretch: 1;
            VerticalLayout {
                width: min(parent.width, 1420px);
                x: (parent.width - self.width) / 2;
                padding-left: 40px;
                padding-right: 40px;
                padding-top: 16px; padding-bottom: 12px;
                spacing: 0px;
                if root.page == "discover": VerticalLayout {
                    spacing: 12px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 6px;
                            Text { text: "Video library"; color: root.ink; font-size: root.compact-view ? 28px : 34px; font-weight: 700; }
                            if !root.compact-view: Text { text: "Open a channel or download a single video"; color: root.muted; font-size: 13px; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        if root.videos.length > 0: Rectangle {
                            width: 102px; height: 30px; border-radius: 15px;
                            background: root.surface; border-width: 1px; border-color: root.edge;
                            Text {
                                text: root.videos.length + (root.videos.length == 1 ? " video" : " videos");
                                color: root.muted; font-size: 12px; font-weight: 600;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            height: 47px; background: root.surface;
                            border-radius: 8px;
                            border-width: 1px; border-color: root.edge;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                padding-left: 15px; padding-right: 10px;
                                spacing: 9px;
                                Text { text: "YouTube link"; color: root.muted; font-size: 12px; font-weight: 600; width: 82px; vertical-alignment: center; }
                                LineEdit {
                                    text <=> root.channel-url;
                                    placeholder-text: "Paste a YouTube channel or video link";
                                    accepted => { if !root.loading { root.load-channel(); } }
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                        ControlButton {
                            width: 176px; height: 47px;
                            label: root.loading ? "Loading..." : "Load channel or video";
                            enabled: !root.loading;
                            primary: true;
                            accent: root.accent; accent-ink: root.accent-ink; surface: root.surface; border: root.edge; text-color: root.ink;
                            clicked => { root.load-channel(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                        height: root.compact-view ? 44px : 56px;
                        horizontal-stretch: 1;
                        background: root.mono ? #1e1e1e : #18191c;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: root.edge;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 12px;
                            Text {
                                width: 61px;
                                text: "SAVED";
                                color: root.faded;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            if root.saved-channels.length == 0: Text {
                                text: "Pin channels for quick access";
                                color: root.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            if root.saved-channels.length > 0: Rectangle {
                                height: 56px;
                                horizontal-stretch: 1;
                                background: transparent;
                                ScrollView {
                                    width: parent.width;
                                    height: 40px;
                                    y: (parent.height - self.height) / 2;
                                    horizontal-scrollbar-policy: as-needed;
                                    vertical-scrollbar-policy: always-off;
                                    content-width: root.saved-channels.length * 233px;
                                    content-height: 40px;
                                    HorizontalLayout {
                                        width: root.saved-channels.length * 233px;
                                        height: 40px;
                                        spacing: 7px;
                                        for channel in root.saved-channels: Rectangle {
                                            width: 226px;
                                            height: 36px;
                                            background: channel.url == root.channel-url ? (root.mono ? #333333 : #2b2b30) : (root.mono ? #292929 : #232428);
                                            border-width: 1px;
                                            border-color: channel.url == root.channel-url ? (root.mono ? #666666 : #53545d) : root.edge;
                                            border-radius: 7px;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 4px;
                                                spacing: 2px;
                                                ControlButton {
                                                    horizontal-stretch: 1;
                                                    min-button-width: 0px;
                                                    height: 32px;
                                                    label: channel.name;
                                                    left-aligned: true;
                                                    enabled: !root.loading;
                                                    border: transparent;
                                                    surface: transparent;
                                                    accent: root.accent;
                                                    accent-ink: root.accent-ink;
                                                    text-color: root.ink;
                                                    clicked => { root.open-saved-channel(channel.url); }
                                                    Tooltip { text: @markdown("Open \{channel.url}"); }
                                                }
                                                ControlButton {
                                                    width: 28px;
                                                    min-button-width: 28px;
                                                    height: 28px;
                                                    label: "×";
                                                    accessible-label: "Remove " + channel.name + " from saved channels";
                                                    border: transparent;
                                                    surface: transparent;
                                                    accent: root.accent;
                                                    accent-ink: root.accent-ink;
                                                    text-color: root.muted;
                                                    clicked => { root.remove-saved-channel(channel.url); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                            Rectangle {
                                width: 152px;
                                height: 56px;
                                background: transparent;
                                ControlButton {
                                    width: parent.width;
                                    height: 37px;
                                    y: (parent.height - self.height) / 2;
                                    label: "From your searches";
                                    accent: root.accent;
                                    accent-ink: root.accent-ink;
                                    surface: root.surface;
                                    border: root.edge;
                                    text-color: root.ink;
                                    clicked => { channel-suggestions.show(); }
                                }
                                channel-suggestions := PopupWindow {
                                    x: parent.width - self.width;
                                    y: parent.height + 4px;
                                    width: 440px;
                                    height: 277px;
                                    close-policy: close-on-click-outside;
                                    Rectangle {
                                        background: root.surface;
                                        border-width: 1px;
                                        border-color: root.edge;
                                        border-radius: 9px;
                                        VerticalLayout {
                                            padding: 14px;
                                            spacing: 8px;
                                            Text {
                                                text: "Suggested from previous channel loads";
                                                font-size: 16px;
                                                font-weight: 700;
                                                color: root.ink;
                                            }
                                            Text {
                                                text: "Save a channel for one-click access above.";
                                                font-size: 12px;
                                                color: root.muted;
                                            }
                                            if root.recommended-channels.length == 0: Rectangle {
                                                vertical-stretch: 1;
                                                background: root.field;
                                                border-radius: 6px;
                                                Text {
                                                    text: "No suggestions yet. Load channels to build your history.";
                                                    color: root.muted;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            if root.recommended-channels.length > 0: ScrollView {
                                                vertical-stretch: 1;
                                                vertical-scrollbar-policy: as-needed;
                                                horizontal-scrollbar-policy: always-off;
                                                VerticalLayout {
                                                    spacing: 5px;
                                                    for suggestion in root.recommended-channels: Rectangle {
                                                        height: 53px;
                                                        background: root.field;
                                                        border-radius: 5px;
                                                        HorizontalLayout {
                                                            padding-left: 12px;
                                                            padding-right: 8px;
                                                            spacing: 8px;
                                                            VerticalLayout {
                                                                padding-top: 7px;
                                                                padding-bottom: 7px;
                                                                spacing: 2px;
                                                                horizontal-stretch: 1;
                                                                Text {
                                                                    text: suggestion.name;
                                                                    font-size: 13px;
                                                                    font-weight: 700;
                                                                    color: root.ink;
                                                                    overflow: elide;
                                                                }
                                                                Text {
                                                                    text: suggestion.url;
                                                                    font-size: 11px;
                                                                    color: root.muted;
                                                                    overflow: elide;
                                                                }
                                                            }
                                                            ControlButton {
                                                                width: 71px;
                                                                height: 33px;
                                                                label: root.saved-channels.length >= 16 ? "Full" : "+ Save";
                                                                enabled: root.saved-channels.length < 16;
                                                                accent: root.accent;
                                                                accent-ink: root.accent-ink;
                                                                surface: root.surface;
                                                                border: root.edge;
                                                                text-color: root.ink;
                                                                clicked => {
                                                                    root.add-recommended-channel(suggestion.url);
                                                                    channel-suggestions.close();
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                    }
                    if root.channel-error != "": Rectangle {
                        height: 46px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.mono ? #6b6662 : #8a414c;
                        background: root.mono ? #292827 : #2b1c20;
                        HorizontalLayout {
                            padding-left: 15px; padding-right: 15px; spacing: 12px;
                            Text { text: "Channel error"; color: root.mono ? #e3d5cb : #ffb0b9; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                            Text { text: root.channel-error; color: root.ink; font-size: 13px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            width: 215px;
                            spacing: 4px;
                            Text { text: root.channel-name; color: root.ink; font-size: 17px; font-weight: 700; overflow: elide; }
                            Text {
                                text: root.video-search != "" ? root.visible-selected-items + " of " + root.videos.length + " matching videos selected" : root.selected-count;
                                color: root.muted; font-size: 12px;
                            }
                        }
                        LineEdit {
                            text <=> root.video-search;
                            placeholder-text: "Filter videos by title";
                            horizontal-stretch: 1;
                        }
                        ControlButton {
                            width: 110px; height: 36px; label: "Select visible";
                            enabled: root.videos.length > root.visible-selected-items;
