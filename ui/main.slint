import { AboutSlint, LineEdit, ScrollView } from "std-widgets.slint";

export struct VideoRow {
    id: string,
    title: string,
    title-long: bool,
    detail: string,
    secondary: string,
    thumbnail: image,
    selected: bool,
}

export struct TaskRow {
    job-index: int,
    title: string,
    title-long: bool,
    detail: string,
    metadata: string,
    thumbnail: image,
    progress: int,
    state: string,
}

export struct ChannelRow {
    name: string,
    url: string,
}

component KeyboardTarget {
    in property <bool> enabled: true;
    // Model row updates can invalidate the active focus item while the
    // callback runs. Only opt-in controls (video checkboxes) reacquire it.
    in property <bool> retain-focus-after-key: false;
    out property <bool> has-hover <=> hit.has-hover;
    out property <bool> has-focus <=> keyboard.has-focus;
    callback clicked <=> hit.clicked;
    forward-focus: keyboard;
    keyboard := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                hit.clicked();
                if (root.retain-focus-after-key && root.enabled) {
                    keyboard.focus();
                }
                return accept;
            }
            return reject;
        }
    }
    // Render the pointer receiver above the keyboard-only element. A zero-size
    // FocusScope must never occlude the visible hit target, including on a
    // maximized Windows window.
    hit := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        mouse-cursor: pointer;
    }
}

component ControlButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> left-aligned: false;
    in property <length> min-button-width: 58px;
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <bool> primary: false;
    in property <color> accent: #d9002b;
    in property <color> accent-ink: #ffffff;
    in property <color> surface: #202124;
    in property <color> border: #36373b;
    in property <color> text-color: #f5f5f6;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    forward-focus: area;

    height: 39px;
    min-width: root.min-button-width;
    border-radius: 6px;
    border-width: 1px;
    border-color: area.has-focus ? root.text-color : !root.enabled ? root.border : (root.primary || root.selected) ? root.accent : root.border;
    background: !root.enabled ? #252527 : (root.primary || root.selected) ? root.accent : area.has-hover ? #323337 : root.surface;
    Text {
        text: root.label;
        x: root.left-aligned ? 10px : 5px;
        width: parent.width - (root.left-aligned ? 20px : 10px);
        overflow: elide;
        color: !root.enabled ? #77797d : (root.primary || root.selected) ? root.accent-ink : root.text-color;
        font-size: 13px;
        font-weight: root.primary ? 700 : 600;
        horizontal-alignment: root.left-aligned ? left : center;
        vertical-alignment: center;
    }
    area := KeyboardTarget {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "YouTube Downloader Desktop — Beta";
    icon: @image-url("../assets/app-icon.png");
    no-frame: true;
    min-width: 880px;
    min-height: 625px;
    max-width: 10000px;
    max-height: 10000px;
    default-font-family: "Segoe UI";
    background: #101113;

    in-out property <string> theme: "red";
    private property <bool> mono: root.theme == "mono";
    private property <color> accent: root.mono ? #eeeeee : #e60032;
    private property <color> accent-ink: root.mono ? #111214 : #ffffff;
    private property <color> canvas: root.mono ? #151515 : #101113;
    private property <color> surface: root.mono ? #242424 : #1b1c1f;
    private property <color> field: root.mono ? #303030 : #232427;
    private property <color> edge: root.mono ? #4b4b4b : #35363a;
    private property <color> ink: #f5f5f6;
    private property <color> muted: root.mono ? #d0d0d0 : #b0b2b6;
    private property <color> faded: root.mono ? #a4a4a4 : #95989d;
    private property <color> selected-bg: root.mono ? #2b2b2b : #211c20;
    private property <bool> has-queue-history: root.pending-items + root.finished-items > 0;

    in-out property <string> channel-url: "";
    in-out property <string> download-folder: "";
    in-out property <string> mode: "video";
    in-out property <string> quality: "best";
    in-out property <string> page: "discover";
    in-out property <string> status-text: "Ready. Paste a channel URL to begin.";
    in-out property <string> channel-error: "";
    in-out property <string> download-error: "";
    in-out property <string> queue-error: "";
    in-out property <string> channel-name: "No channel loaded";
    in-out property <string> selected-count: "0 videos selected";
    in-out property <int> selected-items: 0;
    in-out property <int> visible-selected-items: 0;
    in-out property <string> queue-count: "No downloads yet";
    in-out property <string> video-search: "";
    private property <string> expanded-video-id: "";
    private property <int> expanded-task-index: -1;
    private property <bool> compact-review-visible: false;
    in-out property <string> queue-filter: "all";
    in-out property <int> pending-items: 0;
    in-out property <int> failed-items: 0;
    in-out property <int> finished-items: 0;
    in-out property <bool> loading: false;
    in-out property <bool> more-available: false;
    in-out property <bool> loading-more: false;
    in-out property <string> more-error: "";
    in-out property <bool> fullscreen-active: false;
    in-out property <bool> maximized-active: false;
    in-out property <bool> compact-view: false;
    changed width => {
        root.compact-view = root.width < 1100px;
    }
    changed video-search => {
        // The search must refresh when assistive technology changes the
        // bound value, not only for physical keyboard edit notifications.
        root.search-videos();
    }
    in property <[VideoRow]> videos;
    in property <[VideoRow]> selected-videos;
    in property <[TaskRow]> tasks;
    in property <[ChannelRow]> saved-channels;
    in property <[ChannelRow]> recommended-channels;

    callback change-theme(string);
    callback minimize-window();
    callback close-window();
    callback toggle-fullscreen();
    callback toggle-maximize();
    callback load-channel();
    callback load-more();
    callback toggle-video(string);
    callback search-videos();
    callback select-all();
    callback clear-selection();
    callback choose-folder();
    callback start-download();
    callback cancel-downloads();
    callback retry-failed();
    callback clear-finished();
    callback filter-tasks();
    callback cancel-job(int);
    callback retry-job(int);
    callback open-job-folder(int);
    callback add-recommended-channel(string);
    callback remove-saved-channel(string);
    callback open-saved-channel(string);

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 50px;
            background: root.mono ? #1b1b1b : #17181b;
            // Slint asks Windows to move the window after a real drag. Clicks
            // on the navigation tabs and window controls still reach them.
            WindowMoveArea {
                width: parent.width;
                height: parent.height;
            }
            HorizontalLayout {
                    padding-left: 17px;
                    padding-right: 9px;
                    spacing: 16px;
                    Rectangle {
                        width: 31px;
                        height: 50px;
                        background: transparent;
                        Image {
                            source: @image-url("../assets/app-icon.png");
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 24px;
                            height: 24px;
                            image-fit: contain;
                        }
                    }
                    for tab in [
                        { name: "Library", page: "discover" },
                        { name: "Download options", page: "setup" },
                        { name: "Downloads", page: "queue" }
                    ]: Rectangle {
                        width: tab.page == "setup" ? 151px : 104px;
                        height: 50px;
                        background: transparent;
                        Text { text: tab.name; color: root.page == tab.page ? root.ink : root.muted; font-size: 13px; font-weight: root.page == tab.page ? 700 : 500; vertical-alignment: center; }
                        Rectangle {
                            y: parent.height - 3px;
                            height: 3px;
                            background: root.page == tab.page ? root.accent : tab-hit.has-focus ? root.muted : transparent;
                        }
                        accessible-role: button;
                        accessible-label: tab.name;
                        accessible-action-default => { root.page = tab.page; }
                        tab-hit := KeyboardTarget {
                            width: parent.width; height: parent.height;
                            clicked => { root.page = tab.page; }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; height: 50px; background: transparent; }
                    Rectangle { width: 1px; height: 28px; background: root.edge; }
                    ControlButton {
                        width: 37px; min-button-width: 37px; height: 33px;
                        label: "−";
                        accessible-label: "Minimize window";
                        surface: transparent; border: transparent;
                        accent: root.accent; accent-ink: root.accent-ink; text-color: root.ink;
                        clicked => { root.minimize-window(); }
                    }
                    ControlButton {
                        width: 37px; min-button-width: 37px; height: 33px;
                        label: root.maximized-active ? "❐" : "□";
                        accessible-label: root.maximized-active ? "Restore window" : "Maximize window";
                        surface: transparent; border: transparent;
                        accent: root.accent; accent-ink: root.accent-ink; text-color: root.ink;
                        clicked => { root.toggle-maximize(); }
                    }
                    ControlButton {
                        width: 37px; min-button-width: 37px; height: 33px;
                        label: "×";
                        accessible-label: "Close window";
                        surface: transparent; border: transparent;
                        accent: root.accent; accent-ink: root.accent-ink; text-color: root.ink;
                        clicked => { root.close-window(); }
                    }
            }
        }
        Rectangle { height: 1px; background: root.edge; }
        Rectangle {
            background: root.canvas;
            vertical-stretch: 1;
            VerticalLayout {
                width: min(parent.width, 1420px);
                x: (parent.width - self.width) / 2;
                padding-left: 40px;
                padding-right: 40px;
                padding-top: 16px; padding-bottom: 12px;
                spacing: 0px;
                if root.page == "discover": VerticalLayout {
                    spacing: 12px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 6px;
                            Text { text: "Channel videos"; color: root.ink; font-size: root.width > 1550px ? 31px : 27px; font-weight: 700; }
                            if !root.compact-view || root.videos.length == 0: Text { text: "Browse and select videos to download"; color: root.muted; font-size: 13px; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: root.videos.length == 0 ? "" : root.compact-view && root.videos.length > 3 ? root.videos.length + " VIDEOS · SCROLL ↓" : root.videos.length + " VIDEOS"; color: root.faded; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            height: 47px; background: root.surface;
                            border-radius: 8px;
                            border-width: 1px; border-color: root.edge;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                padding-left: 15px; padding-right: 10px;
                                spacing: 9px;
                            Text { text: "CHANNEL"; color: root.faded; font-size: 12px; font-weight: 700; width: 81px; vertical-alignment: center; }
                                LineEdit {
                                    text <=> root.channel-url;
                                    placeholder-text: "https://youtube.com/@creator";
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                        ControlButton {
                            width: 152px; height: 47px;
                            label: root.loading ? "Loading..." : "Load channel →";
                            enabled: !root.loading;
                            primary: true;
                            accent: root.accent; accent-ink: root.accent-ink; surface: root.surface; border: root.edge; text-color: root.ink;
                            clicked => { root.load-channel(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                        height: 56px;
                        horizontal-stretch: 1;
                        background: root.mono ? #1e1e1e : #18191c;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: root.edge;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 8px;
                            spacing: 12px;
                            Text {
                                width: 61px;
                                text: "SAVED";
                                color: root.faded;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            if root.saved-channels.length == 0: Text {
                                text: "Pin channels for quick access";
                                color: root.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            if root.saved-channels.length > 0: Rectangle {
                                height: 56px;
                                horizontal-stretch: 1;
                                background: transparent;
                                ScrollView {
                                    width: parent.width;
                                    height: 40px;
                                    y: (parent.height - self.height) / 2;
                                    horizontal-scrollbar-policy: as-needed;
                                    vertical-scrollbar-policy: always-off;
                                    content-width: root.saved-channels.length * 233px;
                                    content-height: 40px;
                                    HorizontalLayout {
                                        width: root.saved-channels.length * 233px;
                                        height: 40px;
                                        spacing: 7px;
                                        for channel in root.saved-channels: Rectangle {
                                            width: 226px;
                                            height: 36px;
                                            background: channel.url == root.channel-url ? (root.mono ? #333333 : #2b2b30) : (root.mono ? #292929 : #232428);
                                            border-width: 1px;
                                            border-color: channel.url == root.channel-url ? (root.mono ? #666666 : #53545d) : root.edge;
                                            border-radius: 7px;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 4px;
                                                spacing: 2px;
                                                ControlButton {
                                                    horizontal-stretch: 1;
                                                    min-button-width: 0px;
                                                    height: 32px;
                                                    label: channel.name;
                                                    left-aligned: true;
                                                    enabled: !root.loading;
                                                    border: transparent;
                                                    surface: transparent;
                                                    accent: root.accent;
                                                    accent-ink: root.accent-ink;
                                                    text-color: root.ink;
                                                    clicked => { root.open-saved-channel(channel.url); }
                                                    Tooltip { text: @markdown("Open \{channel.url}"); }
                                                }
                                                ControlButton {
                                                    width: 28px;
                                                    min-button-width: 28px;
                                                    height: 28px;
                                                    label: "×";
                                                    accessible-label: "Remove " + channel.name + " from saved channels";
                                                    border: transparent;
                                                    surface: transparent;
                                                    accent: root.accent;
                                                    accent-ink: root.accent-ink;
                                                    text-color: root.muted;
                                                    clicked => { root.remove-saved-channel(channel.url); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                            Rectangle {
                                width: 152px;
                                height: 56px;
                                background: transparent;
                                ControlButton {
                                    width: parent.width;
                                    height: 37px;
                                    y: (parent.height - self.height) / 2;
                                    label: "From your searches";
                                    accent: root.accent;
                                    accent-ink: root.accent-ink;
                                    surface: root.surface;
                                    border: root.edge;
                                    text-color: root.ink;
                                    clicked => { channel-suggestions.show(); }
                                }
                                channel-suggestions := PopupWindow {
                                    x: parent.width - self.width;
                                    y: parent.height + 4px;
                                    width: 440px;
                                    height: 277px;
                                    close-policy: close-on-click-outside;
                                    Rectangle {
                                        background: root.surface;
                                        border-width: 1px;
                                        border-color: root.edge;
                                        border-radius: 9px;
                                        VerticalLayout {
                                            padding: 14px;
                                            spacing: 8px;
                                            Text {
                                                text: "Suggested from previous channel loads";
                                                font-size: 16px;
                                                font-weight: 700;
                                                color: root.ink;
                                            }
                                            Text {
                                                text: "Save a channel for one-click access above.";
                                                font-size: 12px;
                                                color: root.muted;
                                            }
                                            if root.recommended-channels.length == 0: Rectangle {
                                                vertical-stretch: 1;
                                                background: root.field;
                                                border-radius: 6px;
                                                Text {
                                                    text: "No suggestions yet. Load channels to build your history.";
                                                    color: root.muted;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            if root.recommended-channels.length > 0: ScrollView {
                                                vertical-stretch: 1;
                                                vertical-scrollbar-policy: as-needed;
                                                horizontal-scrollbar-policy: always-off;
                                                VerticalLayout {
                                                    spacing: 5px;
                                                    for suggestion in root.recommended-channels: Rectangle {
                                                        height: 53px;
                                                        background: root.field;
                                                        border-radius: 5px;
                                                        HorizontalLayout {
                                                            padding-left: 12px;
                                                            padding-right: 8px;
                                                            spacing: 8px;
                                                            VerticalLayout {
                                                                padding-top: 7px;
                                                                padding-bottom: 7px;
                                                                spacing: 2px;
                                                                horizontal-stretch: 1;
                                                                Text {
                                                                    text: suggestion.name;
                                                                    font-size: 13px;
                                                                    font-weight: 700;
                                                                    color: root.ink;
                                                                    overflow: elide;
                                                                }
                                                                Text {
                                                                    text: suggestion.url;
                                                                    font-size: 11px;
                                                                    color: root.muted;
                                                                    overflow: elide;
                                                                }
                                                            }
                                                            ControlButton {
                                                                width: 71px;
                                                                height: 33px;
                                                                label: root.saved-channels.length >= 16 ? "Full" : "+ Save";
                                                                enabled: root.saved-channels.length < 16;
                                                                accent: root.accent;
                                                                accent-ink: root.accent-ink;
                                                                surface: root.surface;
                                                                border: root.edge;
                                                                text-color: root.ink;
                                                                clicked => {
                                                                    root.add-recommended-channel(suggestion.url);
                                                                    channel-suggestions.close();
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                    }
                    if root.channel-error != "": Rectangle {
                        height: 46px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.mono ? #6b6662 : #8a414c;
                        background: root.mono ? #292827 : #2b1c20;
                        HorizontalLayout {
                            padding-left: 15px; padding-right: 15px; spacing: 12px;
                            Text { text: "Channel error"; color: root.mono ? #e3d5cb : #ffb0b9; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                            Text { text: root.channel-error; color: root.ink; font-size: 13px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            width: 215px;
                            spacing: 4px;
                            Text { text: root.channel-name; color: root.ink; font-size: 17px; font-weight: 700; overflow: elide; }
                            Text {
                                text: root.video-search != "" ? root.visible-selected-items + " of " + root.videos.length + " matching videos selected" : root.selected-count;
                                color: root.muted; font-size: 12px;
                            }
                        }
                        LineEdit {
                            text <=> root.video-search;
                            placeholder-text: "Filter videos by title";
                            horizontal-stretch: 1;
                        }
                        ControlButton {
                            width: 110px; height: 36px; label: "Select visible";
                            enabled: root.videos.length > root.visible-selected-items;
                            accent: root.accent; accent-ink: root.accent-ink; surface: root.surface; border: root.edge; text-color: root.ink;
                            clicked => { root.select-all(); }
                        }
                        ControlButton {
                            width: 96px; height: 36px; label: "Clear visible";
                            enabled: root.visible-selected-items > 0;
                            accent: root.accent; accent-ink: root.accent-ink; surface: root.surface; border: root.edge; text-color: root.ink;
                            clicked => { root.clear-selection(); }
                        }
                    }
                    Rectangle {
                        background: root.surface;
                        border-width: 1px; border-color: root.edge;
                        border-radius: 8px;
                        height: min(root.videos.length > 0 ? 37px + root.videos.length * 64px + (root.expanded-video-id == "" ? 0px : 63px) : 240px, max(120px, root.height - (root.compact-view ? 423px : 406px) - (root.channel-error == "" ? 0px : 58px)));
                        VerticalLayout {
                            spacing: 0px;
                            Rectangle {
                                height: 36px;
                                background: root.mono ? #303030 : #222327;
                                HorizontalLayout {
                                    padding-left: 20px; padding-right: 22px;
                                    spacing: 12px;
                                    Text { text: "SAVE"; color: root.faded; font-size: 12px; font-weight: 700; width: 57px; vertical-alignment: center; }
                                    Text { text: "VIDEO"; color: root.faded; font-size: 12px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: "LENGTH"; color: root.faded; font-size: 12px; font-weight: 700; width: 110px; horizontal-alignment: right; vertical-alignment: center; }
                                }
                            }
                            Rectangle { height: 1px; background: root.edge; }
                            if root.videos.length > 0: ScrollView {
                                vertical-stretch: 1;
                                scrolled => {
                                    if (root.more-available && !root.loading-more && !root.loading
                                            && root.video-search == "" && root.page == "discover"
                                            && -self.content-y + self.visible-height >= self.content-height - 224px) {
                                        root.load-more();
                                    }
                                }
                                VerticalLayout {
                                    spacing: 0px;
                                    for video[i] in root.videos: Rectangle {
                                        height: video.title-long && root.expanded-video-id == video.id ? 127px : 64px;
                                        forward-focus: video-hit;
                                        accessible-role: checkbox;
                                        accessible-label: video.title;
                                        accessible-enabled: !root.loading;
                                        accessible-checkable: true;
                                        accessible-checked: video.selected;
                                        accessible-action-default => { if (!root.loading) { root.toggle-video(video.id); } }
                                        border-width: video-hit.has-focus ? 1px : 0px;
                                        border-color: video-hit.has-focus ? root.accent : transparent;
                                        background: video-hit.has-hover ? root.mono ? #373737 : #30262a : video.selected ? root.selected-bg : Math.mod(i, 2) == 0 ? root.canvas : root.surface;
                                        video-hit := KeyboardTarget {
                                            width: parent.width; height: 64px;
                                            enabled: !root.loading;
                                            retain-focus-after-key: true;
                                            clicked => { root.toggle-video(video.id); }
                                        }
                                        HorizontalLayout {
                                            x: 0px; y: 0px; height: 64px;
                                            padding-left: 20px; padding-right: 22px;
                                            spacing: 12px;
                                            Rectangle {
                                                width: 57px;
                                                background: transparent;
                                                Rectangle {
                                                    width: 18px; height: 18px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 4px; border-width: 1px;
                                                    border-color: video.selected ? root.accent : root.muted;
                                                    background: video.selected ? root.accent : transparent;
                                                    Text { text: video.selected ? "✓" : ""; color: root.accent-ink; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                                                }
                                            }
                                            Rectangle {
                                                width: 100px; background: transparent;
                                                Rectangle {
                                                    width: parent.width; height: 56px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: 5px; clip: true;
                                                    background: #292a2e;
                                                    Image { source: video.thumbnail; image-fit: cover; }
                                                    if video.thumbnail.width == 0: Text {
                                                        text: "▶"; font-size: 19px; color: root.faded;
                                                        horizontal-alignment: center; vertical-alignment: center;
                                                    }
                                                }
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1; background: transparent;
                                                VerticalLayout {
                                                    height: 42px; y: (parent.height - self.height) / 2;
                                                    spacing: 4px;
                                                    Text {
                                                        height: 20px; text: video.title; color: root.ink; font-size: 15px;
                                                        font-weight: video.selected ? 700 : 600; overflow: elide;
                                                        Tooltip { text: @markdown("\{video.title}"); }
                                                    }
                                                    Text { height: 18px; text: video.secondary; color: root.muted; font-size: 13px; overflow: elide; }
                                                }
                                            }
                                            Text {
                                                text: video.detail; color: root.muted; font-size: 12px;
                                                width: 110px; horizontal-alignment: right;
                                                vertical-alignment: video.title-long ? top : center;
                                                overflow: elide;
                                            }
                                        }
                                        if video.title-long: ControlButton {
                                            x: parent.width - 99px; y: 32px; width: 74px; height: 28px;
                                            label: root.expanded-video-id == video.id ? "Hide title" : "Full title";
                                            accent: root.accent; accent-ink: root.accent-ink;
                                            surface: root.field; border: root.edge; text-color: root.ink;
                                            clicked => { root.expanded-video-id = root.expanded-video-id == video.id ? "" : video.id; }
                                        }
                                        if video.title-long && root.expanded-video-id == video.id: Rectangle {
                                            x: 20px; y: 65px; width: parent.width - 42px; height: 60px;
                                            background: root.field; border-radius: 5px;
                                            Text {
                                                x: 12px; y: 5px; width: parent.width - 24px; height: 50px;
                                                text: video.title; wrap: word-wrap; color: root.ink; font-size: 13px;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Rectangle { y: parent.height - 1px; height: 1px; background: root.edge; }
                                    }
                                    if root.loading-more: Rectangle {
                                        height: 46px; background: root.surface;
                                        Text { text: "Loading 200 more videos…"; color: root.muted; font-size: 13px; vertical-alignment: center; horizontal-alignment: center; }
                                    }
                                    if root.more-error != "": Rectangle {
                                        height: 52px; background: root.surface;
                                        HorizontalLayout {
                                            padding-left: 12px; padding-right: 12px; spacing: 12px;
                                            Text { text: root.more-error; color: root.muted; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                            ControlButton {
                                                width: 94px; height: 34px; label: "Retry loading";
                                                accent: root.accent; accent-ink: root.accent-ink; surface: root.field; border: root.edge; text-color: root.ink;
                                                clicked => { root.load-more(); }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.videos.length == 0: Rectangle {
                                vertical-stretch: 1; background: transparent;
                                Text {
                                    text: root.loading ? "Looking for uploads..." : root.channel-name == "No channel loaded" ? "Your library is empty" : root.video-search != "" ? "No matching videos" : "No videos found";
                                    color: root.ink; font-size: 17px; font-weight: 600;
                                    y: parent.height / 2 - 30px; height: 27px; horizontal-alignment: center;
                                }
                                Text {
                                    text: root.loading ? "Scanning public channel videos" : root.channel-name == "No channel loaded" ? "Paste a YouTube channel above to get started." : root.video-search != "" ? "Try another title or clear the filter." : "Try reloading the channel.";
                                    color: root.muted; font-size: 12px;
                                    y: parent.height / 2 + 8px; height: 25px; horizontal-alignment: center;
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: root.compact-view ? 54px : 62px; background: root.surface;
                        border-width: 1px; border-color: root.edge; border-radius: 8px;
                        HorizontalLayout {
                            padding-left: 23px; padding-right: 20px;
                            spacing: 14px;
                            Rectangle {
                                horizontal-stretch: 1; background: transparent;
                                VerticalLayout {
                                    height: 40px; y: (parent.height - self.height) / 2;
                                    spacing: 4px;
                                    Text { height: 19px; text: root.selected-count; color: root.ink; font-size: 15px; font-weight: 700; }
                                    Text { height: 17px; text: "Choose format, quality and destination next"; color: root.muted; font-size: 12px; }
                                }
                            }
                            Rectangle { width: 192px; background: transparent;
                                ControlButton {
                                    width: parent.width; height: 44px; y: (parent.height - self.height) / 2;
                                    label: "Continue →"; primary: true;
                                    enabled: root.selected-items > 0 && !root.loading;
                                    accent: root.accent; accent-ink: root.accent-ink; surface: root.surface; border: root.edge; text-color: root.ink;
                                    clicked => { root.page = "setup"; }
                                }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
                if root.page == "setup": VerticalLayout {
                    spacing: 14px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 8px;
                            Text { text: "Download settings"; color: root.ink; font-size: root.width > 1550px ? 31px : 27px; font-weight: 700; }
                            Text { text: "Choose how and where to save your selected videos"; color: root.muted; font-size: 13px; }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        if !root.compact-view: Text { text: root.selected-count; color: root.faded; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                    }
                    if !root.compact-view && root.selected-items > 0: ScrollView {
                        height: min(440px, max(305px, root.height - 390px));
                        HorizontalLayout {
                        width: parent.width;
                        height: min(435px, max(305px, root.height - 395px));
                        spacing: 18px;
                        Rectangle {
                            width: (parent.width - 18px) * 0.40;
                            background: root.surface;
                            border-radius: 10px; border-width: 1px; border-color: root.edge;
                            VerticalLayout {
                                padding: 20px; spacing: 12px;
                                VerticalLayout {
                                    spacing: 7px;
                                    Text { text: "Your selection"; color: root.ink; font-size: 19px; font-weight: 700; }
                                    Text { text: root.selected-count; color: root.muted; font-size: 12px; }
                                }
                                Rectangle { height: 1px; background: root.edge; }
                                if root.selected-items > 0: ScrollView {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        spacing: 0px;
                                        for video in root.selected-videos: Rectangle {
                                            height: 68px;
                                            background: transparent;
                                            HorizontalLayout {
                                                spacing: 12px;
                                                Rectangle {
                                                    width: 85px; background: transparent;
                                                    Rectangle {
                                                        width: parent.width; height: 48px;
                                                        y: (parent.height - self.height) / 2;
                                                        background: #303135;
                                                        border-radius: 4px; clip: true;
                                                        Image { source: video.thumbnail; image-fit: cover; }
                                                    }
                                                }
                                                Rectangle {
                                                    horizontal-stretch: 1; background: transparent;
                                                    VerticalLayout {
                                                        height: 40px; y: (parent.height - self.height) / 2;
                                                        spacing: 4px;
                                                        Text {
                                                            height: 19px; text: video.title; color: root.ink; font-size: 13px; overflow: elide;
                                                            Tooltip { text: @markdown("\{video.title}"); }
                                                        }
                                                        Text { height: 17px; text: video.detail; color: root.muted; font-size: 12px; }
                                                    }
                                                }
                                            }
                                            Rectangle { y: parent.height - 1px; height: 1px; background: root.edge; }
                                        }
                                    }
                                }
                                if root.selected-items == 0: Rectangle {
                                    vertical-stretch: 1;
                                Text { text: "Choose videos in Library to continue."; color: root.muted; font-size: 14px; vertical-alignment: center; horizontal-alignment: center; }
                                }
                                ControlButton {
                                    width: 170px; label: root.selected-items > 0 ? "← Edit selection" : "← Choose videos";
                                    accent: root.accent; accent-ink: root.accent-ink; surface: root.field; border: root.edge; text-color: root.ink;
                                    clicked => { root.page = "discover"; }
                                }
                            }
                        }
                        Rectangle {
                            width: (parent.width - 18px) * 0.60;
                            background: root.surface;
                            border-radius: 10px; border-width: 1px; border-color: root.edge;
                            VerticalLayout {
                                padding: 22px; spacing: 17px;
                                Text { text: "Output preferences"; color: root.ink; font-size: 19px; font-weight: 700; }
                                Rectangle { height: 1px; background: root.edge; }
                                VerticalLayout {
                                    spacing: 12px;
                                    Text { text: "SAVE LOCATION"; color: root.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Text { text: root.download-folder; color: root.ink; font-size: 12px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                        ControlButton {
                                            width: 101px; label: "Change";
                                            accent: root.accent; accent-ink: root.accent-ink; surface: root.field; border: root.edge; text-color: root.ink;
                                            clicked => { root.choose-folder(); }
                                        }
                                    }
                                }
                                Rectangle { height: 1px; background: root.edge; }
                                VerticalLayout {
                                    spacing: 12px;
                                    Text { text: "OUTPUT FORMAT"; color: root.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                                    HorizontalLayout {
                                        spacing: 9px;
                                        ControlButton {
                                            width: 95px; label: "Video"; selected: root.mode == "video";
                                            accent: root.accent; accent-ink: root.accent-ink; surface: root.field; border: root.edge; text-color: root.ink;
                                            clicked => { root.mode = "video"; }
                                        }
                                        ControlButton {
                                            width: 105px; label: "Audio MP3"; selected: root.mode == "audio";
                                            accent: root.accent; accent-ink: root.accent-ink; surface: root.field; border: root.edge; text-color: root.ink;
                                            clicked => { root.mode = "audio"; }
                                        }
                                        ControlButton {
                                            width: 100px; label: "Captions"; selected: root.mode == "captions";
                                            accent: root.accent; accent-ink: root.accent-ink; surface: root.field; border: root.edge; text-color: root.ink;
                                            clicked => { root.mode = "captions"; }
                                        }
                                    }
                                }
                                Rectangle { height: 1px; background: root.edge; }
                                VerticalLayout {
                                    spacing: 12px;
                                    Text { text: "VIDEO QUALITY"; color: root.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                                    HorizontalLayout {
                                        spacing: 9px;
                                        for option in [
                                            { label: "Best", id: "best" }, { label: "1080p", id: "1080" }, { label: "720p", id: "720" }, { label: "360p", id: "360" }
                                        ]: ControlButton {
                                            width: 81px; label: option.label; selected: root.quality == option.id; enabled: root.mode == "video";
                                            accent: root.accent; accent-ink: root.accent-ink; surface: root.field; border: root.edge; text-color: root.ink;
                                            clicked => { root.quality = option.id; }
                                        }
                                    }
                                    Text { text: root.mode == "video" ? "MP4 preferred; another container may be used if necessary." : "Quality only applies to video downloads."; color: root.muted; font-size: 12px; }
                                }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                            }
                        }
                    }
                    }
                    if !root.compact-view && root.selected-items == 0: Rectangle {
                        height: 190px;
                        border-width: 1px; border-color: root.edge;
                        border-radius: 9px; background: root.surface;
                        VerticalLayout {
                            padding: 23px;
                            spacing: 12px;
                            Text { text: "Choose videos before setting up a download"; color: root.ink; font-size: 19px; font-weight: 700; }
                            Text { text: "Open Library and select the videos you want to save."; color: root.muted; font-size: 14px; }
                            ControlButton {
                                width: 174px; height: 40px; label: "Browse library"; primary: true;
                                accent: root.accent; accent-ink: root.accent-ink; surface: root.field; border: root.edge; text-color: root.ink;
                                clicked => { root.page = "discover"; }
                            }
                        }
                    }
                    if root.compact-view: ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 13px;
                            Rectangle {
                                height: 50px; background: root.surface;
                                border-radius: 7px; border-width: 1px; border-color: root.edge;
                                HorizontalLayout {
                                    padding-left: 17px; padding-right: 15px; spacing: 10px;
                                    Text {
                                        text: root.compact-review-visible ? root.selected-count + " · SCROLL FOR OPTIONS ↓" : root.selected-count;
                                        color: root.ink; font-size: 13px; font-weight: 600;
                                        vertical-alignment: center; horizontal-stretch: 1;
                                    }
                                    Rectangle { width: 118px; background: transparent;
                                        ControlButton {
                                            width: parent.width; height: 32px; y: (parent.height - self.height) / 2;
                                            label: root.compact-review-visible ? "Hide review" : "Review videos";
                                            enabled: root.selected-items > 0;
                                            accent: root.accent; accent-ink: root.accent-ink; surface: root.field; border: root.edge; text-color: root.ink;
                                            clicked => { root.compact-review-visible = !root.compact-review-visible; }
                                        }
                                    }
                                    Rectangle { width: 120px; background: transparent;
                                        ControlButton {
                                            width: parent.width; height: 32px; y: (parent.height - self.height) / 2;
                                            label: "Edit selection";
                                            accent: root.accent; accent-ink: root.accent-ink; surface: root.field; border: root.edge; text-color: root.ink;
                                            clicked => { root.page = "discover"; }
                                        }
                                    }
                                }
                            }
                            if root.compact-review-visible && root.selected-items > 0: Rectangle {
                                height: min(210px, 55px + root.selected-videos.length * 50px);
                                background: root.field; border-radius: 7px;
                                border-width: 1px; border-color: root.edge;
                                VerticalLayout {
                                    padding: 12px; spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: "SELECTED VIDEOS";
                                            color: root.ink; font-size: 12px; font-weight: 700;
                                            vertical-alignment: center; horizontal-stretch: 1;
                                        }
                                        ControlButton {
                                            width: 76px; height: 29px; label: "Close";
                                            accent: root.accent; accent-ink: root.accent-ink;
                                            surface: root.surface; border: root.edge; text-color: root.ink;
                                            clicked => { root.compact-review-visible = false; }
                                        }
                                    }
                                    ScrollView {
                                        vertical-stretch: 1;
                                        VerticalLayout {
                                            spacing: 0px;
                                            for video[i] in root.selected-videos: Rectangle {
                                                height: 50px; background: transparent;
                                                HorizontalLayout {
                                                    spacing: 10px;
                                                    Rectangle {
                                                        width: 74px; height: 42px; background: root.surface;
                                                        border-radius: 4px; clip: true;
                                                        Image { source: video.thumbnail; image-fit: cover; }
                                                    }
                                                    Text {
                                                        text: (i + 1) + ".  " + video.title;
                                                        color: root.ink; font-size: 13px;
                                                        vertical-alignment: center; wrap: word-wrap;
                                                    }
                                                }
                                                Rectangle { y: parent.height - 1px; height: 1px; background: root.edge; }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                height: 62px; background: root.surface;
                                border-radius: 7px; border-width: 1px; border-color: root.edge;
                                HorizontalLayout {
                                    padding-left: 17px; padding-right: 17px; spacing: 12px;
                                    Text { text: "Save location"; width: 102px; color: root.muted; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                                    Text { text: root.download-folder; color: root.ink; font-size: 12px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                    Rectangle { width: 93px; background: transparent;
                                        ControlButton {
                                            width: parent.width; height: 34px; y: (parent.height - self.height) / 2;
                                            label: "Change";
                                            accent: root.accent; accent-ink: root.accent-ink; surface: root.field; border: root.edge; text-color: root.ink;
                                            clicked => { root.choose-folder(); }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                height: 62px; background: root.surface;
                                border-radius: 7px; border-width: 1px; border-color: root.edge;
                                HorizontalLayout {
                                    padding-left: 17px; spacing: 8px;
                                    Text { text: "Format"; width: 102px; color: root.muted; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                                    for option in [
                                        { id: "video", label: "Video" },
                                        { id: "audio", label: "Audio MP3" },
                                        { id: "captions", label: "Captions" }
                                    ]: Rectangle {
                                        width: 100px; background: transparent;
                                        ControlButton {
                                            width: parent.width; height: 35px; y: (parent.height - self.height) / 2;
                                            label: option.label; selected: root.mode == option.id;
                                            accent: root.accent; accent-ink: root.accent-ink; surface: root.field; border: root.edge; text-color: root.ink;
                                            clicked => { root.mode = option.id; }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                height: 62px; background: root.surface;
                                border-radius: 7px; border-width: 1px; border-color: root.edge;
                                HorizontalLayout {
                                    padding-left: 17px; spacing: 8px;
                                    Text { text: "Video quality"; width: 102px; color: root.muted; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                                    for option in [
                                        { id: "best", label: "Best" }, { id: "1080", label: "1080p" },
                                        { id: "720", label: "720p" }, { id: "360", label: "360p" }
                                    ]: Rectangle {
                                        width: 74px; background: transparent;
                                        ControlButton {
                                            width: parent.width; height: 35px; y: (parent.height - self.height) / 2;
                                            label: option.label; selected: root.quality == option.id;
                                            enabled: root.mode == "video";
                                            accent: root.accent; accent-ink: root.accent-ink; surface: root.field; border: root.edge; text-color: root.ink;
                                            clicked => { root.quality = option.id; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.selected-items > 0 || root.download-error != "": Rectangle {
                        height: 82px;
                        background: root.download-error == "" ? root.surface : root.mono ? #292827 : #2b1c20;
                        border-radius: 10px; border-width: 1px;
                        border-color: root.download-error == "" ? root.edge : root.mono ? #6b6662 : #8a414c;
                        HorizontalLayout {
                            padding-left: 24px; padding-right: 22px;
                            spacing: 10px;
                            Rectangle {
                                horizontal-stretch: 1; background: transparent;
                                VerticalLayout {
                                    height: 42px; y: (parent.height - self.height) / 2;
                                    spacing: 5px;
                                    Text {
                                        height: 19px;
                                        text: root.download-error == "" ? "Ready to download" : "Download error";
                                        color: root.download-error == "" ? root.ink : root.mono ? #e3d5cb : #ffb0b9; font-size: 15px; font-weight: 700;
                                    }
                                    Text {
                                        height: 18px;
                                        text: root.download-error != "" ? root.download-error :
                                            root.compact-view && root.compact-review-visible
                                            ? "Close review or scroll to check format and quality"
                                            : root.selected-count + "  ·  " + (root.mode == "video" ? "Video " + root.quality : root.mode == "audio" ? "Audio MP3" : "Captions") + "  ·  Up to 3 concurrent jobs";
                                        color: root.download-error == "" ? root.muted : root.ink; font-size: 12px; overflow: elide;
                                    }
                                }
                            }
                            Rectangle { width: 195px; background: transparent;
                                ControlButton {
                                    width: parent.width; height: 46px; y: (parent.height - self.height) / 2;
                                    label: "Start downloads →";
                                    primary: true; enabled: root.selected-items > 0 && !root.loading;
                                    accent: root.accent; accent-ink: root.accent-ink; surface: root.surface; border: root.edge; text-color: root.ink;
                                    clicked => { root.start-download(); }
                                }
                            }
                        }
                    }
                    if !root.compact-view: Rectangle { vertical-stretch: 1; background: transparent; }
                }
                if root.page == "queue": VerticalLayout {
                    spacing: 20px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            spacing: 7px;
                            Text { text: "Downloads"; color: root.ink; font-size: root.width > 1550px ? 32px : 28px; font-weight: 700; }
                            Text {
                                text: root.queue-error != "" ? "Action needed: " + root.queue-error
                                    : root.compact-view && root.tasks.length > 2 ? root.queue-count + "  ·  SCROLL ↓" : root.queue-count;
                                color: root.queue-error == "" ? root.muted : root.mono ? #e3d5cb : #ffb0b9;
                                font-size: 13px; overflow: elide;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        if root.has-queue-history: HorizontalLayout {
                            spacing: 10px;
                            ControlButton {
                                width: 108px; label: "Retry failed";
                                enabled: root.failed-items > 0;
                                accent: root.accent; accent-ink: root.accent-ink; surface: root.surface; border: root.edge; text-color: root.ink;
                                clicked => { root.retry-failed(); }
                            }
                            ControlButton {
                                width: 163px; label: "Cancel active & queued";
                                enabled: root.pending-items > 0;
                                accent: root.accent; accent-ink: root.accent-ink; surface: root.surface; border: root.edge; text-color: root.ink;
                                clicked => { root.cancel-downloads(); }
                            }
                            Rectangle {
                                width: 119px; height: 39px; background: transparent;
                                ControlButton {
                                    width: parent.width; height: parent.height; label: "Clear history";
                                    enabled: root.finished-items > 0 && root.pending-items == 0;
                                    accent: root.accent; accent-ink: root.accent-ink; surface: root.surface; border: root.edge; text-color: root.ink;
                                    clicked => { clear-confirmation.show(); }
                                }
                                clear-confirmation := PopupWindow {
                                    x: -292px; y: 45px; width: 410px; height: 164px;
                                    close-policy: close-on-click-outside;
                                    Rectangle {
                                        background: root.surface; border-color: root.edge;
                                        border-width: 1px; border-radius: 9px;
                                        VerticalLayout {
                                            padding: 17px; spacing: 11px;
                                            Text { text: "Clear finished download history?"; font-size: 16px; font-weight: 700; color: root.ink; }
                                            Text {
                                                text: root.finished-items + " completed, failed or cancelled records will be removed. This cannot be undone. Downloaded files stay on disk.";
                                                font-size: 13px; wrap: word-wrap; color: root.muted;
                                            }
                                            HorizontalLayout {
                                                spacing: 9px;
                                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                                ControlButton {
                                                    width: 82px; height: 34px; label: "Cancel";
                                                    accent: root.accent; accent-ink: root.accent-ink; surface: root.field; border: root.edge; text-color: root.ink;
                                                    clicked => { clear-confirmation.close(); }
                                                }
                                                ControlButton {
                                                    width: 130px; height: 34px; label: "Clear records";
                                                    accent: root.accent; accent-ink: root.accent-ink; surface: root.field; border: root.edge; text-color: root.ink;
                                                    clicked => { clear-confirmation.close(); root.clear-finished(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.has-queue-history: HorizontalLayout {
                        spacing: 8px;
                        for option in [
                            { id: "all", label: "All files" }, { id: "active", label: "In progress" },
                            { id: "completed", label: "Completed" }, { id: "failed", label: "Failed" }
                        ]: ControlButton {
                            height: 32px;
                            width: option.id == "active" ? 110px : 98px;
                            label: option.label;
                            selected: root.queue-filter == option.id;
                            accent: root.accent; accent-ink: root.accent-ink; surface: root.surface; border: root.edge; text-color: root.ink;
                            clicked => {
                                root.queue-filter = option.id;
                                root.filter-tasks();
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                    Rectangle {
                        background: root.canvas;
                        height: min(root.tasks.length > 0 ? 45px + root.tasks.length * 106px + (root.expanded-task-index >= 0 ? 58px : 0px) : 240px, max(215px, root.height - 370px));
                        VerticalLayout {
                            spacing: 0px;
                            if root.has-queue-history: Rectangle {
                                height: 44px; background: root.mono ? #303030 : #222327;
                                HorizontalLayout {
                                    padding-left: 24px; padding-right: 26px;
                                    Text { text: "DOWNLOAD / FILE"; color: root.faded; font-size: 12px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                                    Text { text: "STATUS"; color: root.faded; font-size: 12px; font-weight: 700; width: 105px; horizontal-alignment: right; vertical-alignment: center; }
                                }
                            }
                            if root.has-queue-history: Rectangle { height: 1px; background: root.edge; }
                            if root.tasks.length > 0: ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 0px;
                                    for task in root.tasks: Rectangle {
                                        height: task.title-long && root.expanded-task-index == task.job-index ? 164px : 106px;
                                        background: root.surface;
                                        HorizontalLayout {
                                            x: 0px; y: 0px; height: 106px;
                                            padding-left: 20px; padding-right: 20px; spacing: 16px;
                                            Rectangle {
                                                width: 112px; background: transparent;
                                                Rectangle {
                                                    width: parent.width; height: 63px;
                                                    y: (parent.height - self.height) / 2;
                                                    background: #2a2a2d; border-radius: 5px; clip: true;
                                                    Image { source: task.thumbnail; image-fit: cover; }
                                                    if task.thumbnail.width == 0: Text {
                                                        text: "▶"; color: root.faded; font-size: 18px;
                                                        vertical-alignment: center; horizontal-alignment: center;
                                                    }
                                                }
                                            }
                                            VerticalLayout {
                                                padding-top: 13px; padding-bottom: 11px; spacing: 7px;
                                                Text {
                                                    text: task.title; color: root.ink; font-size: root.width > 1550px ? 16px : 15px;
                                                    font-weight: 600; overflow: elide; horizontal-stretch: 1;
                                                    Tooltip { text: @markdown("\{task.title}"); }
                                                }
                                                Text { text: task.metadata; color: root.muted; font-size: 13px; }
                                                Text { text: task.detail; color: root.muted; font-size: 13px; overflow: elide; }
                                                if task.state == "Downloading" || task.state == "Queued": Rectangle {
                                                    height: 5px; border-radius: 2px; background: root.edge;
                                                    Rectangle {
                                                        width: parent.width * task.progress / 100;
                                                        height: parent.height;
                                                        background: root.accent;
                                                        border-radius: 2px;
                                                    }
                                                }
                                            }
                                            VerticalLayout {
                                                width: task.title-long ? 202px : 173px;
                                                padding-top: 15px; padding-bottom: 13px; spacing: 7px;
                                                Text {
                                                    text: task.state == "Downloading" ? task.progress + "% downloading" : task.state;
                                                    color: task.state == "Completed" ? #60cc8a : task.state == "Failed" ? #f38e97 : root.muted;
                                                    font-size: 13px; font-weight: 700; horizontal-alignment: right;
                                                }
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                                    if task.title-long: ControlButton {
                                                        width: 74px; height: 33px;
                                                        label: root.expanded-task-index == task.job-index ? "Hide title" : "Full title";
                                                        accent: root.accent; accent-ink: root.accent-ink;
                                                        surface: root.field; border: root.edge; text-color: root.ink;
                                                        clicked => {
                                                            root.expanded-task-index = root.expanded-task-index == task.job-index ? -1 : task.job-index;
                                                        }
                                                    }
                                                    if task.state == "Failed": ControlButton {
                                                        width: 78px; height: 33px; label: "Retry";
                                                        accent: root.accent; accent-ink: root.accent-ink; surface: root.field; border: root.edge; text-color: root.ink;
                                                        clicked => { root.retry-job(task.job-index); }
                                                    }
                                                    if task.state == "Queued" || task.state == "Downloading": ControlButton {
                                                        width: 78px; height: 33px; label: "Cancel";
                                                        accent: root.accent; accent-ink: root.accent-ink; surface: root.field; border: root.edge; text-color: root.ink;
                                                        clicked => { root.cancel-job(task.job-index); }
                                                    }
                                                    if task.state == "Completed": ControlButton {
                                                        width: 105px; height: 33px; label: "Open folder";
                                                        accent: root.accent; accent-ink: root.accent-ink; surface: root.field; border: root.edge; text-color: root.ink;
                                                        clicked => { root.open-job-folder(task.job-index); }
                                                    }
                                                }
                                            }
                                        }
                                        if task.title-long && root.expanded-task-index == task.job-index: Rectangle {
                                            x: 20px; y: 106px; width: parent.width - 40px; height: 56px;
                                            background: root.field; border-radius: 5px;
                                            Text {
                                                x: 12px; y: 5px; width: parent.width - 24px; height: 45px;
                                                text: task.title; wrap: word-wrap; color: root.ink;
                                                font-size: 13px; vertical-alignment: center;
                                            }
                                        }
                                        Rectangle { y: parent.height - 1px; height: 1px; background: root.edge; }
                                    }
                                }
                            }
                            if root.tasks.length == 0: Rectangle {
                                vertical-stretch: 1; background: transparent;
                                Text { text: root.has-queue-history ? "Nothing in this view" : "Your download queue is empty"; color: root.ink; font-size: 19px; font-weight: 600; y: parent.height / 2 - 73px; height: 30px; horizontal-alignment: center; }
                                Text { text: root.has-queue-history ? "Choose another filter to see your downloads." : "Select videos in Library, then choose download options."; color: root.muted; font-size: 13px; y: parent.height / 2 - 33px; height: 27px; horizontal-alignment: center; }
                                if !root.has-queue-history: ControlButton {
                                    width: 200px; height: 42px;
                                    x: (parent.width - self.width) / 2;
                                    y: parent.height / 2 + 16px;
                                    label: "Browse channel videos";
                                    primary: true;
                                    accent: root.accent; accent-ink: root.accent-ink; surface: root.surface; border: root.edge; text-color: root.ink;
                                    clicked => { root.page = "discover"; }
                                }
                            }
                        }
                    }
                    if root.has-queue-history: HorizontalLayout {
                        spacing: 12px;
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        ControlButton {
                            width: 184px; height: 44px; label: "Browse more videos";
                            accent: root.accent; accent-ink: root.accent-ink; surface: root.surface; border: root.edge; text-color: root.ink;
                            clicked => { root.page = "discover"; }
                        }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
                if root.page == "legal": VerticalLayout {
                    spacing: 25px;
                    Text { text: "About & legal"; color: root.ink; font-size: 29px; font-weight: 700; }
                    Text { text: "A native Windows downloader powered by Rust, Slint, yt-dlp, FFmpeg and Deno."; color: root.muted; font-size: 14px; }
                    Text { text: "Runs locally. No account or online service is required."; color: root.muted; font-size: 13px; }
                    Text { text: "Download only files you own or have permission to save."; color: root.muted; font-size: 13px; }
                    AboutSlint {}
                    ControlButton {
                        width: 158px; label: "← Back to library";
                        accent: root.accent; accent-ink: root.accent-ink; surface: root.surface; border: root.edge; text-color: root.ink;
                        clicked => { root.page = "discover"; }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
        }
        Rectangle { height: 1px; background: root.edge; }
        Rectangle {
            height: 43px; background: root.mono ? #202020 : #17181b;
            HorizontalLayout {
                width: min(parent.width, 1420px);
                x: (parent.width - self.width) / 2;
                padding-left: 40px; padding-right: 40px; spacing: 8px;
                Rectangle { width: 7px; background: transparent;
                    Rectangle { width: 7px; height: 7px; y: (parent.height - self.height) / 2; border-radius: 4px; background: root.muted; }
                }
                Text { text: root.status-text; color: root.muted; font-size: 12px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                Text { text: "THEME"; color: root.faded; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                Rectangle { width: 78px; background: transparent;
                    ControlButton {
                        width: parent.width; height: 30px; y: (parent.height - self.height) / 2;
                        label: "YouTube"; selected: !root.mono;
                        accent: root.accent; accent-ink: root.accent-ink; surface: root.surface; border: root.edge; text-color: root.ink;
                        clicked => { root.change-theme("red"); }
                    }
                }
                Rectangle { width: 60px; background: transparent;
                    ControlButton {
                        width: parent.width; height: 30px; y: (parent.height - self.height) / 2;
                        label: "Mono"; selected: root.mono;
                        accent: root.accent; accent-ink: root.accent-ink; surface: root.surface; border: root.edge; text-color: root.ink;
                        clicked => { root.change-theme("mono"); }
                    }
                }
                Rectangle { width: 94px; background: transparent;
                    ControlButton {
                        width: parent.width; height: 30px; y: (parent.height - self.height) / 2;
                        label: root.fullscreen-active ? "Exit full" : "Fullscreen";
                        accent: root.accent; accent-ink: root.accent-ink; surface: root.surface; border: root.edge; text-color: root.ink;
                        clicked => { root.toggle-fullscreen(); }
                    }
                }
                Rectangle { width: 110px; background: transparent;
                    ControlButton {
                        width: parent.width; height: 29px; y: (parent.height - self.height) / 2;
                        label: "About & legal";
                        accent: root.accent; accent-ink: root.accent-ink; surface: root.mono ? #202020 : #17181b; border: root.mono ? #202020 : #17181b; text-color: root.muted;
                        clicked => { root.page = "legal"; }
                    }
                }
            }
        }
    }
}
